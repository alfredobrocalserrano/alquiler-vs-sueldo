	partition dim_provincia = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dim_provincia.csv"),[Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"cod_prov", type text}, {"provincia", type text}, {"ccaa", type text}, {"provincia_corta", type text}, {"ubicacion_mapa", type text}, {"es_alicante", type logical}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

